# --- Database -------------------------------------------------------------
# Docker Compose supplies this automatically; override for a local Postgres.
DATABASE_URL=postgresql+asyncpg://kintix:kintix_secret@localhost:5432/kintix_db

# --- Semantic Analysis & Blueprint Generation (Groq) -----------------------
# Optional. Used for semantic process naming/classification and blueprint generation.
# If missing, pipeline falls back to conservative deterministic heuristic.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Active Groq models: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b

# --- App ------------------------------------------------------------------
DEBUG=false

